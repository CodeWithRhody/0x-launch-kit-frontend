# Network Configuration
REACT_APP_NETWORK_ID=1
REACT_APP_CHAIN_ID=1

# Relayer Configuration (Backend API)
REACT_APP_RELAYER_URL=https://your-backend-url.onrender.com/sra/v3
REACT_APP_RELAYER_WS_URL=wss://your-backend-url.onrender.com/sra/v3

# App Configuration
REACT_APP_DEFAULT_BASE_PATH=/erc20
REACT_APP_THEME_NAME=LIGHT_THEME

# Ethereum RPC URL (for direct blockchain interaction)
REACT_APP_ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_PROJECT_ID
