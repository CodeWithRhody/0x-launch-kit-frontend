{
    "version": 2,
    "builds": [
        {
            "src": "package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "build"
            }
        }
    ],
    "routes": [
        {
            "src": "/static/(.*)",
            "dest": "/static/$1"
        },
        {
            "src": "/favicon.ico",
            "dest": "/favicon.ico"
        },
        {
            "src": "/manifest.json",
            "dest": "/manifest.json"
        },
        {
            "src": "/(.*)",
            "dest": "/index.html"
        }
    ],
    "env": {
        "REACT_APP_NETWORK_ID": "1",
        "REACT_APP_CHAIN_ID": "1",
        "REACT_APP_DEFAULT_BASE_PATH": "/erc20",
        "REACT_APP_THEME_NAME": "LIGHT_THEME"
    }
}
